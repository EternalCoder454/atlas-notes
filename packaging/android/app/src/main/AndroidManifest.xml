<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Atlas Notes keeps your notes on your device and needs no network to work.
      This is here for exactly two things, both of which you start: the check
      for a newer version, and downloading one.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Atlas Notes is sideloaded, so Android will not update it on its own. This
      is what lets the app hand a newer build to the system installer when you
      ask it to. It is a request, not a right: Android still asks you to allow
      this app specifically, and the installer still shows you what it is about
      to do. And an update signed with a different key than the one already
      installed is refused by the system, so this cannot be used to replace
      Atlas Notes with something else.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Only for a vault kept in a shared folder, which is how the same notes
      reach both a phone and a computer: a sync app such as Syncthing keeps the
      folder in step, and Atlas Notes reads and writes it. The notes are opened
      as ordinary files by the Go core the desktop also runs, and Android lets
      an app do that in shared storage only with these. Nothing is asked for
      until someone chooses a shared folder, and the app's own storage needs
      none of them.

      Android 11 and later: "All files access", granted on its own settings
      page. The Play Store restricts it; Atlas Notes is not on the Play Store.
      Android 10 and earlier: the older pair, capped so they are never asked
      for where they would do nothing.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
      For the morning reminder of tasks that are due. Android 13 and later
      make showing any notification a permission, asked for once, and only
      when there is a task due to remind of. The boot one is so the reminder
      can be set again after the phone restarts, which forgets every alarm.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.AtlasNotes">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Sharing text from any app makes a note of it. Single-task, above,
                 is what hands a share to the app when it is already running. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- The shortcuts shown when the app's icon is held down. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The quick-settings tile. The system, and nothing else, may bind to
             it: that is what the permission says, and why it can be exported. -->
        <service
            android:name=".CaptureTile"
            android:exported="true"
            android:icon="@drawable/ic_new_note"
            android:label="@string/new_note"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The home-screen widget. Only the system sends it updates, so it is
             not exported. -->
        <receiver
            android:name=".NewNoteWidget"
            android:exported="false"
            android:label="@string/new_note">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/new_note_widget_info" />
        </receiver>

        <!-- The daily alarm for the reminder of tasks due. Only this app's own
             PendingIntent sends to it, so it is not exported. -->
        <receiver
            android:name=".DueReceiver"
            android:exported="false" />

        <!-- Sets that alarm again after a restart or an update, which clear
             it. Both broadcasts come from the system, which may send to a
             receiver that is not exported. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The installer runs in another process, so a downloaded build has to
             be handed over as a content URI rather than a path. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
