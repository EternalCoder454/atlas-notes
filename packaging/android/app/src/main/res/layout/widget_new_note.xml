<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole widget: one rounded button. NewNoteWidget puts the tap on the root,
  so pressing anywhere on it, and not only on the words, opens a new note.
  Only views a RemoteViews can hold are used, and the padding is spelled
  left and right because paddingHorizontal is newer than Android 7.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_new_note"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_new_note_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="12dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_new_note" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/new_note"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
