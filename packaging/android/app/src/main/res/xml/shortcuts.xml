<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher shortcuts, shown when the app's icon is held down. The first
  opens the same request the tile and the widget do; the second opens today's
  note.

  The target package has to be written out, because resources are not run
  through the manifest's ${applicationId} placeholder. It is the release build's
  id, so a debug build, whose id ends in .debug, needs its own copy of this file
  under src/debug/res/xml to have a working shortcut.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_note"
        android:shortcutId="new_note"
        android:shortcutLongLabel="@string/new_note"
        android:shortcutShortLabel="@string/new_note">
        <intent
            android:action="io.github.atlasnotes.action.NEW_NOTE"
            android:targetClass="io.github.atlasnotes.MainActivity"
            android:targetPackage="io.github.atlasnotes" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_today"
        android:shortcutId="today"
        android:shortcutLongLabel="@string/today"
        android:shortcutShortLabel="@string/today">
        <intent
            android:action="io.github.atlasnotes.action.TODAY"
            android:targetClass="io.github.atlasnotes.MainActivity"
            android:targetPackage="io.github.atlasnotes" />
    </shortcut>
</shortcuts>
