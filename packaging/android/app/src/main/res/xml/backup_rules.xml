<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android is allowed to back up and to carry to a new phone.

  The vault goes, because losing your notes when you change phones would be the
  worst thing this app could do. Locked notes are encrypted on disk, so they
  travel encrypted and still need the password on the other side.

  The cache does not go: it holds downloaded APKs and nothing worth keeping.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="vault" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="vault" />
    </device-transfer>
</data-extraction-rules>
