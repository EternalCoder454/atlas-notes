<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind the Compose content. It matches the light scheme's
         surface so launching does not flash a different colour before the
         first frame; res/values-night has the dark one. -->
    <style name="Theme.AtlasNotes" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
