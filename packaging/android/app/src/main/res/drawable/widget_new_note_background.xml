<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's button: a fully rounded bar of the logo's blue. The ripple is
  what shows a tap has landed, and its mask is the bar, so it stays inside the
  rounded corners.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/capture_accent" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</ripple>
